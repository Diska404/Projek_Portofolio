{
  "name": "devpulse-portfolio",
  "version": "0.1.0-r0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @devpulse/web",
    "build": "npm run build --workspace @devpulse/web",
    "start": "npm run start --workspace @devpulse/web",
    "typecheck": "npm run typecheck --workspace @devpulse/web",
    "lint": "eslint apps packages tests scripts *.mjs *.ts",
    "format": "prettier --write apps packages tests scripts *.json *.mjs *.ts .github",
    "format:check": "prettier --check apps packages tests scripts *.json *.mjs *.ts .github",
    "test": "tsx --test tests/*.test.ts",
    "test:http": "tsx scripts/http-smoke.ts",
    "test:ui": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run check:secrets && npm run build",
    "prepare": "husky",
    "test:production": "node scripts/production-smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1"
  }
}
